{
    "name" : "oihana/php-middleware" ,
    "type" : "library" ,
    "description" : "Composable PHP middleware helpers — security headers (HSTS, CSP, X-Frame-Options, Referrer-Policy, X-Content-Type-Options), CORS with preflight, CSRF, request-id, maintenance mode, rate limiting. PSR-7 compatible, zero magic strings." ,
    "keywords" : [
        "php" ,
        "http" ,
        "middleware" ,
        "psr-7" ,
        "security" ,
        "security-headers" ,
        "cors" ,
        "csp" ,
        "hsts" ,
        "csrf" ,
        "request-id" ,
        "maintenance" ,
        "rate-limit" ,
        "rate-limiting"
    ] ,
    "homepage" : "https://github.com/BcommeBois/oihana-php-middleware" ,
    "license" : "MPL-2.0" ,
    "authors" : [
        {
            "name"     : "Marc Alcaraz" ,
            "email"    : "marc@ooop.fr" ,
            "homepage" : "https://www.ooop.fr" ,
            "role"     : "Project Founder, Lead Developer."
        }
    ] ,
    "support" : {
        "email"  : "marc@ooop.fr" ,
        "issues" : "https://github.com/BcommeBois/oihana-php-middleware/issues" ,
        "source" : "https://github.com/BcommeBois/oihana-php-middleware"
    } ,
    "scripts" : {
        "doc"  : "rm -rf docs && mkdir docs && cp -r assets docs/assets && ./vendor/bin/phpdoc -c phpdoc.xml -v" ,
        "test" : "./vendor/bin/phpunit"
    } ,
    "autoload" : {
        "psr-4" : {
            "oihana\\middleware\\" : "src/oihana/middleware"
        } ,
        "files" : [
            "src/oihana/middleware/helpers/body/enforceMaxBodySize.php" ,
            "src/oihana/middleware/helpers/cors/applyCorsHeaders.php" ,
            "src/oihana/middleware/helpers/cors/isCorsPreflight.php" ,
            "src/oihana/middleware/helpers/cors/isCorsRequest.php" ,
            "src/oihana/middleware/helpers/csrf/generateCsrfToken.php" ,
            "src/oihana/middleware/helpers/csrf/verifyCsrfToken.php" ,
            "src/oihana/middleware/helpers/maintenance/respondMaintenanceMode.php" ,
            "src/oihana/middleware/helpers/negotiation/negotiateMimeType.php" ,
            "src/oihana/middleware/helpers/observability/withResponseTime.php" ,
            "src/oihana/middleware/helpers/problem/respondProblemDetails.php" ,
            "src/oihana/middleware/helpers/rateLimit/enforceRateLimit.php" ,
            "src/oihana/middleware/helpers/rateLimit/withRateLimitHeaders.php" ,
            "src/oihana/middleware/helpers/requestId/requestIdFromRequest.php" ,
            "src/oihana/middleware/helpers/requestId/withRequestIdHeader.php" ,
            "src/oihana/middleware/helpers/security/buildCspHeader.php" ,
            "src/oihana/middleware/helpers/security/buildPermissionsPolicyHeader.php" ,
            "src/oihana/middleware/helpers/security/withDefaultSecurityBaseline.php" ,
            "src/oihana/middleware/helpers/security/withSecurityHeaders.php" ,
            "src/oihana/middleware/helpers/tracing/traceContextFromRequest.php" ,
            "src/oihana/middleware/helpers/tracing/withTracingAttribute.php" ,
            "src/oihana/middleware/helpers/tracing/withTraceparentResponseHeader.php" ,
            "src/oihana/middleware/helpers/webhook/verifyWebhookSignature.php" ,
            "src/oihana/middleware/tracing/parseTraceparent.php"
        ]
    } ,
    "autoload-dev" : {
        "psr-4" : {
            "tests\\oihana\\middleware\\" : "tests/oihana/middleware"
        }
    } ,
    "require" : {
        "php"                  : ">=8.4" ,
        "psr/http-message"     : "^2.0" ,
        "oihana/php-enums"     : "dev-main" ,
        "oihana/php-http"      : "dev-main"
    } ,
    "require-dev" : {
        "phpunit/phpunit"      : "^12" ,
        "nunomaduro/collision" : "^8.8" ,
        "phpdocumentor/shim"   : "^3.8" ,
        "slim/psr7"            : "^1.7"
    } ,
    "suggest" : {
        "oihana/php-memcached" : "Provides MemcachedRateLimitStore (production-grade backend for enforceRateLimit())."
    } ,
    "minimum-stability" : "dev" ,
    "prefer-stable" : true ,
    "config" : {
        "allow-plugins" : {
            "phpdocumentor/shim" : true
        }
    }
}
